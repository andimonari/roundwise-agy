# Roundwise Backend Environment Configuration
PORT=3001
API_VERSION=v1

# PostgreSQL Database (Optional - falls back to in-memory store if unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roundwise

# Live Speech & AI Providers (Optional - falls back to high-fidelity local simulator if unset)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# LLM & Voice Models
LLM_MODEL=claude-haiku-4-5
SCORING_MODEL=claude-3-5-sonnet-20241022
STT_MODEL=nova-2
TTS_MODEL=eleven_flash_v2_5

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
